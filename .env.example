# Copy to .env for local runs. On Vercel, set these as project
# environment variables instead (Settings → Environment Variables).

# Required
OPENAI_API_KEY=
GOOGLE_MAPS_KEY=
OPENWEATHER_KEY=

# Optional — OpenTelemetry export is off unless an endpoint is set
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=voyage-api
# ENVIRONMENT=development
